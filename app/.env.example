# ===========================================
# 🎮 Sui Solitaire Game - Environment Variables
# ===========================================

# ===== REQUIRED: Sui Blockchain Configuration =====
# Sui network URL endpoint (testnet/devnet/mainnet)
NEXT_PUBLIC_SUI_NETWORK=https://fullnode.testnet.sui.io:443

# Sui network name identifier
NEXT_PUBLIC_SUI_NETWORK_NAME=testnet

# Smart contract package address on Sui blockchain
# Deploy your solitaire Move package and put the address here
NEXT_PUBLIC_PACKAGE_ADDRESS=0x1234567890abcdef1234567890abcdef12345678

# ===== REQUIRED: Enoki Wallet Integration =====
# Enoki API key for client-side wallet operations
NEXT_PUBLIC_ENOKI_API_KEY=your_enoki_api_key_here

# Enoki secret key for server-side operations (KEEP SECRET!)
ENOKI_SECRET_KEY=your_enoki_secret_key_here

# ===== REQUIRED: Google OAuth Integration =====
# Google OAuth client ID for social login
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ===== REQUIRED: Admin Configuration =====
# Administrative secret key for server operations (KEEP SECRET!)
ADMIN_SECRET_KEY=your_admin_secret_key_here

# ===== OPTIONAL: UI Configuration =====
# Use top navbar on large screens (1) or side navbar (0)
NEXT_PUBLIC_USE_TOP_NAVBAR_IN_LARGE_SCREEN=1

# ===== OPTIONAL: Development/Deployment =====
# Node.js environment
NODE_ENV=development

# Server port (for Docker/deployment)
PORT=3000

# Server hostname (for Docker/deployment)
HOSTNAME=0.0.0.0

# Disable Next.js telemetry (uncomment if desired)
# NEXT_TELEMETRY_DISABLED=1

# Server-side rendering debug flag (development only)
# IS_SERVER_SIDE=true

# ===== OPTIONAL: Vercel KV Database (only if using Vercel) =====
# Vercel KV REST API tokens and URLs
# KV_REST_API_READ_ONLY_TOKEN=your_kv_read_only_token
# KV_REST_API_TOKEN=your_kv_token
# KV_REST_API_URL=your_kv_rest_api_url
# KV_URL=your_kv_url

# ===== OPTIONAL: Vercel Deployment (auto-set by Vercel) =====
# VERCEL=1
# VERCEL_ENV=production
# VERCEL_URL=your-app.vercel.app
# VERCEL_REGION=iad1

# ===========================================
# 📝 Setup Instructions:
# ===========================================
# 1. Copy this file to .env.local (for local development)
# 2. Fill in all REQUIRED values above
# 3. For production, set these in your deployment platform
# 4. Never commit .env.local to version control!
#
# 🔧 How to get the values:
# - Deploy the Move package: `sui client publish --gas-budget 100000000`
# - Get Enoki keys: https://enoki.mystenlabs.com/
# - Get Google Client ID: https://console.developers.google.com/
# - Generate admin secret: Use a secure random string generator
# ===========================================